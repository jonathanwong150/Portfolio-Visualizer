# Copy to .env and fill in as needed.

# Data source selection (prototype defaults use mock/seed data)
BROKER_PROVIDER=mock          # mock | plaid
MARKET_PROVIDER=seed          # seed | yfinance
ETF_PROVIDER=seed             # seed | fmp

# Plaid (Phase 3 - only needed when BROKER_PROVIDER=plaid)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox             # sandbox | development | production
PLAID_PRODUCTS=investments
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=

# Persistence (Phase 3)
DATABASE_URL=sqlite:///./portfolio.db

# Financial Modeling Prep (upgrade path - only when *_PROVIDER=fmp/yfinance)
FMP_API_KEY=

# App
CORS_ORIGINS=http://localhost:5173
