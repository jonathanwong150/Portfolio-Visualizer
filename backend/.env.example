# Copy to .env and fill in as needed.

# Data source selection
BROKER_PROVIDER=db            # db | mock | plaid  (db = imported holdings, mock fallback)
MARKET_PROVIDER=seed          # seed | alphavantage
ETF_PROVIDER=seed             # seed | alphavantage | fmp

# Alpha Vantage (Phase 5) - real prices, fundamentals and ETF constituents.
# Free key: https://www.alphavantage.co/support/#api-key
# Without this the app falls back to synthesized prices, which are not real.
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_MAX_CALLS_PER_REFRESH=40
METADATA_TTL_DAYS=30
CONSTITUENTS_TTL_DAYS=30
PRICES_TTL_HOURS=12

# Plaid (Phase 3 - only needed when BROKER_PROVIDER=plaid)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox             # sandbox | development | production
PLAID_PRODUCTS=investments
PLAID_COUNTRY_CODES=US
PLAID_REDIRECT_URI=

# Persistence (Phase 3)
DATABASE_URL=sqlite:///./portfolio.db

# Financial Modeling Prep (unused upgrade path)
FMP_API_KEY=

# App
CORS_ORIGINS=http://localhost:5173
